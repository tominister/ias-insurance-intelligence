# Insurance Intelligence Assistant API
# Copy to .env and fill in values. Never commit .env.

IAS_ENV=development
IAS_API_HOST=127.0.0.1
IAS_API_PORT=8000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo mode — synthetic insurance records (no live RMIS credentials required)
USE_MOCK_DATA=true

# Azure OpenAI via API Management (optional for local demo without LLM)
# AZURE_OPENAI_API_BASE_URL=https://your-apim.azure-api.net/your-product
# AZURE_OPENAI_SUBSCRIPTION_KEY=your-apim-subscription-key
# AZURE_OPENAI_MODEL=gpt-4o

# Embedding-based intent routing (requires Azure OpenAI embeddings route)
USE_EMBEDDING_INTENT=true
INTENT_EMBEDDING_THRESHOLD=0.72
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Microsoft Entra ID (optional)
# AUTH_ENABLED=false
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
