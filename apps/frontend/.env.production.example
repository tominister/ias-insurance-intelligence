# Frontend (local dev)
VITE_API_BASE_URL=/api

# Microsoft Entra ID (leave empty for local open API)
# VITE_AZURE_TENANT_ID=
# VITE_AZURE_CLIENT_ID=
# VITE_AZURE_REDIRECT_URI=
# VITE_AZURE_API_SCOPE=api://<client-id>/access_as_user

# Deployed chat may exceed SWA 45s linked-backend limit — set direct App Service URL + CORS:
# VITE_API_BASE_URL=https://app-<name>.azurewebsites.net
